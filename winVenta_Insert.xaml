<Window x:Class="sisgesoriadao.winVenta_Insert"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:sisgesoriadao"
        xmlns:controls="clr-namespace:System.Windows.Controls;assembly=DotNetProjects.Input.Toolkit"
        mc:Ignorable="d"
        Title="Sistema de Ventas - Registrar Venta"
        MinWidth="1200" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded" Closing="Window_Closing"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="14"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}">

    <Window.Resources>
        <!-- Estilos personalizados -->
        <Style x:Key="SectionCard" TargetType="materialDesign:Card">
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="UniformCornerRadius" Value="8"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryHueMidBrush}"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="4"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ========== ENCABEZADO PRINCIPAL ========== -->
        <materialDesign:ColorZone x:Name="colorZoneHeader" Grid.Row="0" Mode="PrimaryMid" Padding="16" 
                                   materialDesign:ElevationAssist.Elevation="Dp4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Botón Volver -->
                <Button x:Name="btnReturn" 
                        Grid.Column="0"
                        Style="{StaticResource MaterialDesignIconButton}"
                        ToolTip="Volver a inicio" 
                        Click="btnReturn_Click"
                        Foreground="White"
                        Margin="0,0,16,0">
                    <materialDesign:PackIcon Kind="ArrowLeft" Width="24" Height="24"/>
                </Button>

                <!-- Información central -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="Store" Width="24" Height="24" 
                                            VerticalAlignment="Center" Foreground="White"/>
                    <TextBlock x:Name="txtSucursal" Text="SUCURSAL" 
                              Margin="8,0,24,0" FontSize="16" 
                              VerticalAlignment="Center" FontWeight="Medium" Foreground="White"/>

                    <materialDesign:PackIcon Kind="Account" Width="24" Height="24" 
                                            VerticalAlignment="Center" Foreground="White"/>
                    <TextBlock x:Name="txtBlockWelcome" Text="USUARIO" 
                              Margin="8,0,24,0" FontSize="16" 
                              VerticalAlignment="Center" FontWeight="Medium" Foreground="White"/>

                    <materialDesign:PackIcon Kind="ShoppingOutline" Width="24" Height="24" 
                                            VerticalAlignment="Center" Foreground="White"/>
                    <TextBlock x:Name="tituloVentana" Text="REGISTRAR VENTA" 
                              Margin="8,0,0,0" FontSize="18" 
                              VerticalAlignment="Center" FontWeight="Bold" Foreground="White"/>
                </StackPanel>

                <!-- Cambio del dólar -->
                <Border Grid.Column="2" 
                        Background="{DynamicResource PrimaryHueLightBrush}"
                        CornerRadius="4" Padding="12,6">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="CurrencyUsd" Width="20" Height="20" 
                                                VerticalAlignment="Center" Foreground="White"/>
                        <TextBlock Text="Tipo de cambio:" Margin="8,0,8,0" 
                                  VerticalAlignment="Center" Foreground="White" FontSize="12"/>
                        <TextBlock x:Name="txtCambioDolar" Text="6.97" 
                                  FontSize="16" FontWeight="Bold" 
                                  VerticalAlignment="Center" Foreground="White"/>
                    </StackPanel>
                </Border>
            </Grid>
        </materialDesign:ColorZone>

        <!-- ========== CONTENIDO PRINCIPAL ========== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Orientation="Vertical" Margin="16">

                <!-- ========== CONFIGURACIÓN DE VENTA ========== -->
                <materialDesign:Card Style="{StaticResource SectionCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Observaciones -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="NoteTextOutline" 
                                                    VerticalAlignment="Center" 
                                                    Margin="0,0,8,0"/>
                            <TextBox x:Name="txtObservacionVenta" 
                                    materialDesign:HintAssist.Hint="Observaciones"
                                    materialDesign:HintAssist.IsFloating="True"
                                    Width="300" 
                                    MaxLength="99" 
                                    VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Empleado -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0">
                            <materialDesign:PackIcon Kind="AccountTie" 
                                                    VerticalAlignment="Center" 
                                                    Margin="0,0,8,0"/>
                            <!--<TextBlock Text="Venta por mayor" 
                                      VerticalAlignment="Center" 
                                      Margin="0,0,12,0"/>
                            <ToggleButton x:Name="tglWholesale" 
                                         Style="{StaticResource MaterialDesignSwitchToggleButton}" 
                                         ToolTip="Indicar si es venta por mayor" 
                                         Click="tglWholesale_Click"/> -->
                            <ComboBox x:Name="cbxEmployees" 
                                     materialDesign:HintAssist.Hint="Empleado"
                                     materialDesign:HintAssist.IsFloating="True"
                                     MinWidth="200"
                                     IsEnabled="True"/>
                        </StackPanel>

                        <!-- Venta por mayor -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="PackageVariant" 
                                                    VerticalAlignment="Center" 
                                                    Margin="0,0,8,0"/>
                            <ComboBox x:Name="cbxSaleType" 
                                    SelectionChanged="cbxSaleType_SelectionChanged"
                                    materialDesign:HintAssist.Hint="Tipo de venta"
                                    materialDesign:HintAssist.IsFloating="True"
                                    MinWidth="200"
                                    IsEnabled="True"/>
                        </StackPanel>
                    </Grid>
                </materialDesign:Card>

                <!-- ========== INFORMACIÓN DEL CLIENTE ========== -->
                <materialDesign:Card Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="INFORMACIÓN DEL CLIENTE" Style="{StaticResource SectionTitle}"/>

                        <!-- Mensaje de ayuda -->
                        <Border Background="{DynamicResource MaterialDesignDivider}" 
                                CornerRadius="4" Padding="12" Margin="0,0,0,16">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <materialDesign:PackIcon Kind="InformationOutline" 
                                                            VerticalAlignment="Top" 
                                                            Margin="0,2,8,0"
                                                            Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="13">
                                        <Run FontWeight="SemiBold">Consejo:</Run>
                                        <Run>Presione ENTER en el campo nombre para seleccionar un cliente existente.</Run>
                                    </TextBlock>
                                </StackPanel>
                                <TextBlock TextWrapping="Wrap" FontSize="13" Margin="32,0,0,0">
                                    También puede buscar por carnet o celular, o registrar un nuevo cliente.
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Búsqueda de cliente -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <!-- Campo de autocompletado -->
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Nombre del cliente *" 
                                              FontSize="12" 
                                              Foreground="{DynamicResource MaterialDesignBodyLight}"
                                              Margin="0,0,0,4"/>
                                    <controls:AutoCompleteBox x:Name="acbtxtNameCustomer" 
                                                             MinWidth="280" 
                                                             IsEnabled="True" 
                                                             FilterMode="Contains" 
                                                             KeyDown="acbtxtNameCustomer_KeyDown" 
                                                             FontSize="14"/>
                                </StackPanel>

                                <!-- Campo de búsqueda -->
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Carnet o celular" 
                                              FontSize="12" 
                                              Foreground="{DynamicResource MaterialDesignBodyLight}"
                                              Margin="0,0,0,4"/>
                                    <TextBox x:Name="txtSearchCustomer" 
                                            MinWidth="160" 
                                            MaxLength="15" 
                                            IsEnabled="True" 
                                            KeyDown="txtSearchCustomer_KeyDown"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Botones de acción -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                                <Button x:Name="btnSearchCustomer" 
                                       Style="{StaticResource IconButton}"
                                       ToolTip="Buscar cliente" 
                                       Click="btnSearchCustomer_Click"
                                       Background="{DynamicResource PrimaryHueMidBrush}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Magnify" Margin="0,0,4,0"/>
                                        <TextBlock Text="Buscar"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="btnAddCustomer" 
                                       Style="{StaticResource IconButton}"
                                       ToolTip="Añadir cliente" 
                                       Click="btnAddCustomer_Click"
                                       Background="#4CAF50">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="AccountPlus" Margin="0,0,4,0"/>
                                        <TextBlock Text="Nuevo"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="btnEditCustomer" 
                                       Style="{StaticResource IconButton}"
                                       ToolTip="Modificar cliente" 
                                       Click="btnEditCustomer_Click" 
                                       IsEnabled="False"
                                       Background="#FF9800">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="AccountEdit" Margin="0,0,4,0"/>
                                        <TextBlock Text="Editar"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Mensaje de búsqueda -->
                        <TextBlock x:Name="lblSearchCustomerInfo" 
                                  Text="" 
                                  Margin="0,12,0,0"
                                  FontWeight="Medium"
                                  Foreground="{DynamicResource PrimaryHueMidBrush}"/>

                        <!-- Datos del cliente encontrado -->
                        <StackPanel x:Name="stackpanelCustomerFound" 
                                   Orientation="Horizontal" 
                                   Margin="0,16,0,0" 
                                   Visibility="Visible">
                            <Border Background="{DynamicResource MaterialDesignDivider}" 
                                   CornerRadius="4" Padding="12" Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="CardAccountDetails" 
                                                            VerticalAlignment="Center" 
                                                            Margin="0,0,8,0"
                                                            Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                    <TextBlock x:Name="lblCustomerNumeroCI" 
                                              Text="C.I.: -" 
                                              FontWeight="Medium" 
                                              FontSize="14"
                                              VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource MaterialDesignDivider}" 
                                   CornerRadius="4" Padding="12">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Cellphone" 
                                                            VerticalAlignment="Center" 
                                                            Margin="0,0,8,0"
                                                            Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                    <TextBlock x:Name="lblCustomerNumeroCelular" 
                                              Text="Celular: -" 
                                              FontWeight="Medium" 
                                              FontSize="14"
                                              VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Formulario de registro de cliente -->
                        <StackPanel x:Name="stackpanelCustomerForm" 
                                   Orientation="Vertical" 
                                   Margin="0,16,0,0" 
                                   Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBox x:Name="txtRegister_Nombre" 
                                        Grid.Column="0"
                                        materialDesign:HintAssist.Hint="Nombre *"
                                        materialDesign:HintAssist.IsFloating="True"
                                        Margin="0,0,8,0"
                                        MaxLength="60" 
                                        IsEnabled="False" 
                                        KeyUp="TextBoxUppercase"
                                        KeyDown="txtClear_KeyDown"/>

                                <TextBox x:Name="txtRegister_NumeroCelular" 
                                        Grid.Column="1"
                                        materialDesign:HintAssist.Hint="Número de celular *"
                                        materialDesign:HintAssist.IsFloating="True"
                                        Margin="0,0,8,0"
                                        MaxLength="15" 
                                        IsEnabled="False"
                                        KeyDown="txtClear_KeyDown"/>

                                <TextBox x:Name="txtRegister_NumeroCI" 
                                        Grid.Column="2"
                                        materialDesign:HintAssist.Hint="Número de carnet"
                                        materialDesign:HintAssist.IsFloating="True"
                                        MaxLength="20" 
                                        IsEnabled="False"
                                        KeyDown="txtClear_KeyDown"/>
                            </Grid>
                        </StackPanel>
                        <StackPanel x:Name="stackpanelCustomerButtons" Orientation="Horizontal" Margin="15,25,0,25" Visibility="Collapsed">
                            <Button x:Name="btnSaveNewCustomer" Content="GUARDAR" IsEnabled="False" Click="btnSaveNewCustomer_Click"/>
                            <Button x:Name="btnCancelNewCustomer" Content="CANCELAR" Margin="10,0,0,0" IsEnabled="False" Click="btnCancelNewCustomer_Click" Background="White" Foreground="Black" BorderBrush="Black"/>
                        </StackPanel>
                    </StackPanel>
                </materialDesign:Card>

                <!-- ========== PRODUCTOS ========== -->
                <materialDesign:Card Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="PRODUCTOS" Style="{StaticResource SectionTitle}"/>

                        <!-- Búsqueda de producto -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="txtSearchProduct" 
                                    Grid.Column="0"
                                    materialDesign:HintAssist.Hint="Buscar producto por código o nombre"
                                    materialDesign:HintAssist.IsFloating="True"
                                    MinWidth="300"
                                    MaxLength="100" 
                                    IsEnabled="True" 
                                    KeyDown="txtSearchProduct_KeyDown"/>

                            <Button x:Name="btnSearchProduct" 
                                   Grid.Column="1"
                                   Style="{StaticResource IconButton}"
                                   ToolTip="Buscar producto" 
                                   Click="btnSearchProduct_Click" 
                                   IsEnabled="True"
                                   Background="{DynamicResource PrimaryHueMidBrush}"
                                   Margin="8,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Magnify" Margin="0,0,4,0"/>
                                    <TextBlock Text="Buscar"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <TextBlock x:Name="lblSearchProductInfo" 
                                  Text="" 
                                  Margin="0,0,0,12"
                                  FontWeight="Medium"
                                  Foreground="{DynamicResource PrimaryHueMidBrush}"/>

                        <!-- DataGrid de productos -->
                        <DataGrid x:Name="dgvProductos" 
                                 AutoGenerateColumns="False" 
                                 PreviewTextInput="txtPrecio_PreviewTextInput" 
                                 CanUserAddRows="False" 
                                 CanUserDeleteRows="False" 
                                 CanUserSortColumns="False" 
                                 CanUserReorderColumns="False" 
                                 Loaded="dgvProductos_Loaded" 
                                 CellEditEnding="dgvProductos_CellEditEnding"
                                 materialDesign:DataGridAssist.CellPadding="8"
                                 materialDesign:DataGridAssist.ColumnHeaderPadding="8">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding idProducto}" IsReadOnly="True" Visibility="Collapsed"/>
                                <DataGridTextColumn Header="Código" Binding="{Binding codigoSublote}" IsReadOnly="True" Width="100"/>
                                <DataGridTextColumn Header="Producto" Binding="{Binding nombreProducto}" IsReadOnly="True" Width="*"/>
                                <DataGridTextColumn Header="Detalle" Binding="{Binding identificador}" IsReadOnly="True" Width="120"/>
                                <DataGridTextColumn Header="Precio USD" Binding="{Binding precioUSD}" IsReadOnly="True" Width="90">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#2196F3"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Precio Bs." Binding="{Binding precioBOB}" IsReadOnly="True" Width="90">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#2196F3"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Desc. %" Binding="{Binding descuentoPorcentaje}" Width="70"/>
                                <DataGridTextColumn Header="Desc. $" Binding="{Binding descuentoUSD}" Width="70"/>
                                <DataGridTextColumn Header="Desc. Bs." Binding="{Binding descuentoBOB}" Width="80"/>
                                <DataGridTextColumn Header="Total $" Binding="{Binding totalproductoUSD}" Width="90">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#4CAF50"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Total Bs." Binding="{Binding totalproductoBOB}" Width="90">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#4CAF50"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Garantía" Binding="{Binding garantia}" Width="90">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#F44336"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Costo $" Binding="{Binding costoUSD}" IsReadOnly="True" Visibility="Collapsed"/>

                                <DataGridTemplateColumn Width="125">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Click="btndgvRemoverProducto"
                                                   Style="{StaticResource MaterialDesignFlatButton}"
                                                   Foreground="#F44336">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="Delete" Margin="0,0,4,0"/>
                                                    <TextBlock Text="Quitar"/>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock x:Name="lblDataGridRows" 
                                  Text="Registros: 0" 
                                  Margin="0,8,0,0"
                                  FontSize="12"
                                  Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                    </StackPanel>
                </materialDesign:Card>

                <!-- ========== RESUMEN Y PAGO ========== -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Métodos de pago -->
                    <materialDesign:Card Grid.Column="0" Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Text="MÉTODOS DE PAGO" Style="{StaticResource SectionTitle}"/>

                            <!-- Controles de pago -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <ComboBox x:Name="cbxPaymentMethod" 
                                         Grid.Column="0"
                                         materialDesign:HintAssist.Hint="Tipo de pago"
                                         materialDesign:HintAssist.IsFloating="True"
                                         IsEnabled="True" 
                                         MinWidth="150"
                                         Margin="0,0,16,0"/>

                                <TextBox x:Name="txtPagoUSD" 
                                        Grid.Column="1"
                                        materialDesign:HintAssist.Hint="Monto USD"
                                        materialDesign:HintAssist.IsFloating="True"
                                        MinWidth="100"
                                        MaxLength="8" 
                                        IsEnabled="True" 
                                        PreviewTextInput="txtPrecio_PreviewTextInput" 
                                        KeyUp="txtPagoUSD_KeyUp" 
                                        KeyDown="txtPagoUSD_KeyDown"
                                        Margin="0,0,16,0"/>

                                <TextBox x:Name="txtPagoBOB" 
                                        Grid.Column="2"
                                        materialDesign:HintAssist.Hint="Monto Bs."
                                        materialDesign:HintAssist.IsFloating="True"
                                        MinWidth="100" 
                                        MaxLength="8" 
                                        IsEnabled="True" 
                                        PreviewTextInput="txtPrecio_PreviewTextInput" 
                                        KeyUp="txtPagoBOB_KeyUp" 
                                        KeyDown="txtPagoBOB_KeyDown"
                                        Margin="0,0,16,0"/>

                                <Button x:Name="btnAddPaymentMethod" 
                                       Grid.Column="3"
                                       Style="{StaticResource IconButton}"
                                       ToolTip="Añadir método de pago" 
                                       Click="btnAddPaymentMethod_Click" 
                                       IsEnabled="True"
                                       Background="#4CAF50">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Plus" Margin="0,0,4,0"/>
                                        <TextBlock Text="Agregar"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- DataGrid métodos de pago -->
                            <DataGrid x:Name="dgvMetodosPago" 
                                     CanUserAddRows="False" 
                                     CanUserDeleteRows="False" 
                                     IsReadOnly="True"
                                     SelectionChanged="dgvMetodosPago_SelectionChanged"
                                     materialDesign:DataGridAssist.CellPadding="8"
                                     materialDesign:DataGridAssist.ColumnHeaderPadding="8">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Monto USD" Binding="{Binding montoUSD}" IsReadOnly="True" Width="*"/>
                                    <DataGridTextColumn Header="Monto Bs." Binding="{Binding montoBOB}" IsReadOnly="True" Width="*"/>
                                    <DataGridTextColumn Header="Tipo de pago" Binding="{Binding tipo}" IsReadOnly="True" Width="*"/>

                                    <DataGridTemplateColumn Width="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Click="btndgvRemoverMetodoPago"
                                                       Style="{StaticResource MaterialDesignFlatButton}"
                                                       Foreground="#F44336">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="Delete" Margin="0,0,4,0"/>
                                                        <TextBlock Text="Quitar"/>
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- Resumen de totales -->
                    <materialDesign:Card Grid.Column="1" Style="{StaticResource SectionCard}" MinWidth="300">
                        <StackPanel>
                            <TextBlock Text="RESUMEN" Style="{StaticResource SectionTitle}"/>

                            <!-- Total venta -->
                            <Border Background="{DynamicResource PrimaryHueLightBrush}" 
           CornerRadius="4" Padding="12" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Total USD:" 
                      FontWeight="SemiBold" Margin="0,0,12,8" Foreground="White"/>
                                    <TextBlock x:Name="txtVentaTotalVentaUSD" 
                    Grid.Row="0" Grid.Column="1"
                    FontWeight="Bold" 
                    FontSize="16"
                    Margin="0,0,0,8"
                    Foreground="White"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Total Bs.:" 
                      FontWeight="SemiBold" Margin="0,0,12,0" Foreground="White"/>
                                    <TextBlock x:Name="txtVentaTotalVentaBOB" 
                    Grid.Row="1" Grid.Column="1"
                    FontWeight="Bold" 
                    FontSize="16"
                    Foreground="White"/>
                                </Grid>
                            </Border>

                            <!-- Total pagado -->
                            <Border Background="{DynamicResource MaterialDesignDivider}" 
           CornerRadius="4" Padding="12" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Pagado USD:" 
                      FontWeight="Medium" Margin="0,0,12,8"/>
                                    <TextBlock x:Name="txtVentaTotalPagoUSD" 
                    Grid.Row="0" Grid.Column="1"
                    FontWeight="SemiBold"
                    Margin="0,0,0,8"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Pagado Bs.:" 
                      FontWeight="Medium" Margin="0,0,12,0"/>
                                    <TextBlock x:Name="txtVentaTotalPagoBOB" 
                    Grid.Row="1" Grid.Column="1"
                    FontWeight="SemiBold"/>
                                </Grid>
                            </Border>

                            <!-- Saldo pendiente -->
                            <Border Background="#FFF3E0" 
           CornerRadius="4" Padding="12" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Saldo USD:" 
                      FontWeight="SemiBold" Margin="0,0,12,8" Foreground="#FF6F00"/>
                                    <TextBlock x:Name="txtVentaTotalSaldoUSD" 
                    Grid.Row="0" Grid.Column="1"
                    FontWeight="Bold"
                    Margin="0,0,0,8"
                    Foreground="#FF6F00"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Saldo Bs.:" 
                      FontWeight="SemiBold" Margin="0,0,12,0" Foreground="#FF6F00"/>
                                    <TextBlock x:Name="txtVentaTotalSaldoBOB" 
                    Grid.Row="1" Grid.Column="1"
                    FontWeight="Bold"
                    Foreground="#FF6F00"/>
                                </Grid>
                            </Border>

                            <!-- Botón registrar -->
                            <Button x:Name="btnSaveAndPDF" 
           ToolTip="Registrar venta e imprimir" 
           Click="btnSaveAndPDF_Click" 
           IsEnabled="True"
           Style="{StaticResource MaterialDesignRaisedButton}"
           Background="#4CAF50"
           Height="48"
           FontSize="15"
           FontWeight="SemiBold">
                                <Button.Content>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="CheckCircle" 
                                        VerticalAlignment="Center" 
                                        Margin="0,0,8,0"
                                        Width="20" Height="20"/>
                                        <TextBlock Text="REGISTRAR E IMPRIMIR" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button.Content>
                            </Button>
                        </StackPanel>
                    </materialDesign:Card>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
