<Window x:Class="sisgesoriadao.winVenta_Detalle_2"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
     TextElement.Foreground="#212121"
     TextElement.FontWeight="Regular"
     TextElement.FontSize="13"
     TextOptions.TextFormattingMode="Ideal"
     TextOptions.TextRenderingMode="Auto"
     Background="#fafafa"
     FontFamily="{DynamicResource MaterialDesignFont}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:sisgesoriadao"
        mc:Ignorable="d"
        Title="Sistema de Ventas - Detalle de Venta" Height="600" Width="1280"
        WindowStartupLocation="CenterScreen" Loaded="Window_Loaded" ResizeMode="NoResize">
    <ScrollViewer>
        <StackPanel Orientation="Vertical">

            <!-- ═══════════════════════════════════════════════════════
                 BARRA DE BOTONES (idéntica a la ventana original)
            ════════════════════════════════════════════════════════ -->
            <StackPanel Orientation="Horizontal" Margin="10">
                <Button x:Name="btnReturn" ToolTip="VOLVER A INICIO" Margin="0,0,20,0" Click="btnReturn_Click">
                    <materialDesign:PackIcon Kind="ArrowLeftBold"/>
                </Button>
                <materialDesign:PackIcon Kind="PersonBox" Width="25" Height="25" VerticalAlignment="Center"/>
                <TextBlock x:Name="txtBlockWelcome" Text="USUARIO" Margin="5,0,0,0" FontSize="19" VerticalAlignment="Center" FontWeight="Bold"/>
                <TextBlock Text="/" Margin="10,0,10,0" FontSize="23" VerticalAlignment="Center" FontWeight="Bold"/>
                <materialDesign:PackIcon Kind="CartOutline" Width="25" Height="25" VerticalAlignment="Center"/>
                <TextBlock Text="DETALLE DE VENTA" Margin="5,0,0,0" FontSize="19" VerticalAlignment="Center" FontWeight="Bold"/>
                <Button x:Name="btnPrint" ToolTip="IMPRIMIR VENTA" Margin="15,0,0,0" Click="btnPrint_Click" Background="White" Foreground="Black" BorderBrush="Black">
                    <materialDesign:PackIcon Kind="Printer" Width="50"/>
                </Button>
                <Button x:Name="btnPrintRollo" Content="IMPRIMIR ROLLO" Click="btnPrintRollo_Click" Margin="15,0,0,0" Background="White" Foreground="Black" BorderBrush="Black"/>
                <Button x:Name="btnPrintPDF" ToolTip="IMPRIMIR PARA PDF" Margin="15,0,0,0" Click="btnPrintPDF_Click" Foreground="White">
                    <materialDesign:PackIcon Kind="FilePdfBox" Width="50"/>
                </Button>
                <Button x:Name="btnCopy" ToolTip="COPIAR IMEIS O S/N's AL PORTAPAPELES" Margin="15,0,0,0" Click="btnCopy_Click" Background="White" Foreground="Black" BorderBrush="Black">
                    <materialDesign:PackIcon Kind="ContentCopy" Width="50"/>
                </Button>
                <Button x:Name="btnModifySale" ToolTip="MODIFICAR VENTA" Margin="15,0,0,0" Click="btnModifySale_Click" Background="Orange" Foreground="White" BorderBrush="Orange">
                    <materialDesign:PackIcon Kind="Edit" Width="50"/>
                </Button>
            </StackPanel>

            <!-- ═══════════════════════════════════════════════════════
                 ZONA DE IMPRESIÓN
            ════════════════════════════════════════════════════════ -->
            <Grid>
                <Grid x:Name="ZonaImpresionGrid" Margin="10,10,10,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Fila 0: banda de encabezado -->
                        <RowDefinition Height="Auto"/>
                        <!-- Fila 1: datos del cliente   -->
                        <RowDefinition Height="Auto"/>
                        <!-- Fila 2: tabla + pie         -->
                    </Grid.RowDefinitions>

                    <!-- ───────────────────────────────────────────────
                         FILA 0 — Banda de encabezado (Variante A)
                         Logo | Título + Nro. | Sucursal + Fecha
                    ──────────────────────────────────────────────── -->
                    <Border Grid.Row="0"
                            BorderBrush="#CCCCCC" BorderThickness="0,0,0,1"
                            Padding="12,10" Margin="0,0,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <!-- Logo          -->
                                <ColumnDefinition Width="*"/>
                                <!-- Título + Nro. -->
                                <ColumnDefinition Width="Auto"/>
                                <!-- Sucursal       -->
                            </Grid.ColumnDefinitions>

                            <!-- Logo -->
                            <Image Grid.Column="0"
                                   Height="70" Width="70"
                                   Source="/sisgesoriadao;component/Resources/logo.png"
                                   VerticalAlignment="Center"
                                   Margin="0,0,14,0"
                                   Stretch="Uniform"/>

                            <!-- Título y número de venta -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="txtTitulo"
                                           Text="BOLETA DE GARANTÍA"
                                           FontSize="22" FontWeight="Bold"/>
                                <TextBlock x:Name="txtIdVenta"
                                           Text="Nro.: 00000"
                                           FontSize="15" FontWeight="Bold"
                                           Foreground="#555555"/>
                            </StackPanel>

                            <!-- Datos de sucursal y fecha (alineados a la derecha) -->
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <TextBlock x:Name="txtSucursal_nombre"
                                           Text="SUCURSAL_NOMBRE"
                                           FontWeight="Bold" FontSize="14"
                                           TextAlignment="Right" TextWrapping="Wrap" MaxWidth="300"/>
                                <TextBlock x:Name="txtSucursal_direccion"
                                           Text="SUCURSAL_DIRECCION"
                                           FontSize="13" TextAlignment="Right"
                                           TextWrapping="Wrap" MaxWidth="300" Margin="0,2,0,0"/>
                                <TextBlock x:Name="txtSucursal_telefono"
                                           Text="SUCURSAL_TELEFONO"
                                           FontSize="13" TextAlignment="Right" Margin="0,2,0,0"/>
                                <TextBlock x:Name="txtSucursal_correo"
                                           Text="SUCURSAL_CORREO"
                                           FontSize="13" TextAlignment="Right" Margin="0,2,0,0"/>
                                <TextBlock x:Name="txtVenta_fecha"
                                           Text="Fecha: VENTA_FECHA"
                                           FontWeight="Bold" FontSize="13"
                                           TextAlignment="Right" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ───────────────────────────────────────────────
                         FILA 1 — Datos del cliente en fila compacta
                    ──────────────────────────────────────────────── -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal"
                                Margin="12,10,12,6">
                        <TextBlock x:Name="txtCliente_nombre"
                                   Text="Cliente: CLIENTE_NOMBRE"
                                   FontWeight="Bold" FontSize="15" Margin="0,0,20,0"/>
                        <TextBlock x:Name="txtCliente_celular"
                                   Text="Telefono/Celular: CLIENTE_CELULAR"
                                   FontSize="15" Margin="0,0,20,0"/>
                        <TextBlock x:Name="txtCliente_ci"
                                   Text="C.I.: CLIENTE_CI"
                                   FontSize="15"/>
                    </StackPanel>

                    <!-- ───────────────────────────────────────────────
                         FILA 2 — Tabla de productos + pie
                    ──────────────────────────────────────────────── -->
                    <StackPanel Grid.Row="2" Margin="12,0,12,10">

                        <!-- Encabezados de columna -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="0*"/>
                                <ColumnDefinition Width="0*"/>
                                <ColumnDefinition Width="0*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="DESCRIPCIÓN"   FontSize="14" FontWeight="Bold" Margin="4,0" TextAlignment="Left"/>
                            <TextBlock Grid.Column="1" Text="DETALLE"       FontSize="14" FontWeight="Bold" TextAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="GARANTÍA"      FontSize="14" FontWeight="Bold" TextAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="CANTIDAD"      FontSize="14" FontWeight="Bold" TextAlignment="Center"/>
                            <TextBlock Grid.Column="4" Text="PRECIO Bs."    FontSize="14" FontWeight="Bold" TextAlignment="Center" Visibility="Hidden"/>
                            <TextBlock Grid.Column="5" Text="DESC. %"       FontSize="14" FontWeight="Bold" TextAlignment="Center" Visibility="Hidden"/>
                            <TextBlock Grid.Column="6" Text="DESC. Bs."     FontSize="14" FontWeight="Bold" TextAlignment="Center" Visibility="Hidden"/>
                            <TextBlock Grid.Column="7" x:Name="thTotal"
                                       Text="TOTAL Bs."
                                       FontSize="14" FontWeight="Bold" TextAlignment="Right" Margin="0,0,4,0"/>
                        </Grid>

                        <Rectangle Fill="#333333" Height="1" Margin="0,4"/>

                        <!-- Filas de productos -->
                        <Grid MinHeight="120">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="0*"/>
                                <ColumnDefinition Width="0*"/>
                                <ColumnDefinition Width="0*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="txtProducto_Descripcion"        Grid.Column="0" Text="PRODUCTO_DESCRIPCION" FontSize="14" Margin="4,0" TextWrapping="Wrap"/>
                            <TextBlock x:Name="txtProducto_Detalle"             Grid.Column="1" Text="0" FontSize="14" TextWrapping="Wrap" TextAlignment="Center"/>
                            <TextBlock x:Name="txtProducto_Garantia"            Grid.Column="2" Text="0" FontSize="14" TextAlignment="Center"/>
                            <TextBlock x:Name="txtProducto_Cantidad"            Grid.Column="3" Text="1" FontSize="14" TextAlignment="Center"/>
                            <TextBlock x:Name="txtProducto_Precio"              Grid.Column="4" Text="0" FontSize="14" TextAlignment="Center" Visibility="Hidden"/>
                            <TextBlock x:Name="txtProducto_DescuentoPorcentaje" Grid.Column="5" Text="0" FontSize="14" TextAlignment="Center" Visibility="Hidden"/>
                            <TextBlock x:Name="txtProducto_DescuentoBOB"        Grid.Column="6" Text="0" FontSize="14" TextAlignment="Center" Visibility="Hidden"/>
                            <TextBlock x:Name="txtProducto_TotalBOB"            Grid.Column="7" Text="0" FontSize="14" TextAlignment="Right" Margin="0,0,4,0"/>
                        </Grid>

                        <Rectangle Fill="#333333" Height="1" Margin="0,4"/>

                        <!-- Observaciones -->
                        <TextBlock x:Name="txtObservaciones"
                                   Text="Observaciones: - | Ejecutivo de ventas: @USUARIO_NOMBRE - Cel.: @USUARIO_CELULAR"
                                   TextWrapping="Wrap" FontSize="13" Margin="4,4,4,8"/>

                        <!-- Pie: firmas | pagos | totales -->
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <!-- Firmas  -->
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <!-- Pagos   -->
                                <ColumnDefinition Width="Auto"/>
                                <!-- Totales -->
                            </Grid.ColumnDefinitions>

                            <!-- Firmas -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal"
                                        VerticalAlignment="Bottom" Margin="0,0,20,0">
                                <StackPanel VerticalAlignment="Bottom" Margin="0,0,30,0">
                                    <Rectangle x:Name="shapeFirmaResponsable"
                                               Fill="Black" Height="1" Margin="10,0"/>
                                    <TextBlock x:Name="txtFirmaResponsable"
                                               Text="Firma Responsable"
                                               FontSize="13" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel VerticalAlignment="Bottom">
                                    <Rectangle x:Name="shapeFirmaCliente"
                                               Fill="Black" Height="1" Margin="10,0"/>
                                    <TextBlock x:Name="txtFirmaCliente"
                                               Text="Conformidad Cliente"
                                               FontSize="13" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>

                            <Image Grid.Column="1"
                                   x:Name="imgQR"
                                   Height="110"
                                   Width="110"
                                   Margin="10,0,0,0"/>

                            <!-- Pagos -->
                            <StackPanel Grid.Column="2" Width="200" Margin="0,0,16,0">
                                <TextBlock x:Name="txtSubtituloPagos"
                                           Text="PAGOS (Bs.)"
                                           FontWeight="Bold" FontSize="13"
                                           HorizontalAlignment="Center"/>
                                <TextBlock x:Name="txtPagos"
                                           Text="1/1/2000  0"
                                           FontSize="13" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <!-- Totales -->
                            <Border Grid.Column="3"
                                    Background="#F0F0F0"
                                    BorderBrush="#CCCCCC" BorderThickness="1"
                                    CornerRadius="4" Padding="12,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="90"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="TOTAL:"    FontWeight="Bold" FontSize="14" Margin="0,1"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="ADELANTO:" FontWeight="Bold" FontSize="14" Margin="0,1"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="SALDO:"    FontWeight="Bold" FontSize="14" Margin="0,1"/>

                                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="txtVenta_Total"
                                               Text="0" FontWeight="Bold" FontSize="14"
                                               TextAlignment="Right" Margin="8,1,0,1"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="txtVenta_Adelanto"
                                               Text="0" FontWeight="Bold" FontSize="14"
                                               TextAlignment="Right" Margin="8,1,0,1"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="txtVenta_Saldo"
                                               Text="0" FontWeight="Bold" FontSize="14"
                                               TextAlignment="Right" Margin="8,1,0,1"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</Window>
